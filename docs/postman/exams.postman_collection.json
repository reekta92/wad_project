{
  "info": {
    "name": "Faculty Exams \u2014 implemented public API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requires the documented development services and Go API. Covers all currently implemented public endpoints plus validation/error cases. No privileged routes or authentication bypass are included."
  },
  "item": [
    {
      "name": "Process liveness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/health/live"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Process is live', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Dependency readiness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Both services ready', () => { const body = pm.response.json(); pm.expect(body.checks.database).to.eql('ok'); pm.expect(body.checks.identity).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Published schedule",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/schedule?page=1&page_size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const page = pm.response.json();",
              "pm.test('Valid page metadata', () => { pm.expect(page.data).to.be.an('array'); pm.expect(page.page).to.be.above(0); pm.expect(page.page_size).to.be.within(1, 100); pm.expect(page.total).to.be.at.least(0); });",
              "pm.test('Joined published exam data', () => page.data.forEach(exam => { pm.expect(exam).to.have.all.keys('id', 'course_id', 'course_code', 'course_name', 'term', 'department_id', 'department', 'session_id', 'date', 'start_time', 'end_time', 'rooms'); pm.expect(exam.rooms).to.be.an('array'); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter and paginate schedule",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/schedule?page=1&page_size=1&q={{q}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const page = pm.response.json();",
              "pm.test('Valid page metadata', () => { pm.expect(page.data).to.be.an('array'); pm.expect(page.page).to.be.above(0); pm.expect(page.page_size).to.be.within(1, 100); pm.expect(page.total).to.be.at.least(0); });",
              "pm.test('Joined published exam data', () => page.data.forEach(exam => { pm.expect(exam).to.have.all.keys('id', 'course_id', 'course_code', 'course_name', 'term', 'department_id', 'department', 'session_id', 'date', 'start_time', 'end_time', 'rooms'); pm.expect(exam.rooms).to.be.an('array'); }));",
              "pm.test('Course filter applied', () => pm.response.json().data.forEach(exam => pm.expect((exam.course_code + ' ' + exam.course_name).toLowerCase()).to.include(pm.environment.get('q').toLowerCase())));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid page size",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/schedule?page_size=101"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Structured validation error', () => pm.expect(pm.response.json().error).to.include.all.keys('code', 'message', 'request_id'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject unsupported representation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/xml"
          }
        ],
        "url": "{{base_url}}/api/v1/schedule"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 406', () => pm.response.to.have.status(406));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown API does not return the SPA",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/missing"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Structured API error', () => pm.expect(pm.response.json().error.message).to.eql('API resource not found.'));"
            ]
          }
        }
      ]
    }
  ]
}
