digraph ExamManagement {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", fontsize=15,
         pad=0.25, nodesep=0.4, ranksep=0.65, compound=true];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#334155",
        fontname="DejaVu Sans", fontsize=12, margin="0.14,0.10"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569"];

  browser [label="Browser\nReact / Vite / Tailwind CSS\nPKCE; JWT held in memory"];

  subgraph cluster_host {
    label="Single host";
    color="#64748b";
    style="rounded,dashed";

    api [label="Go / Fiber\nREST API + React static build\nJWT, role and ownership checks\nScheduling; audit; exports"];
    identity [label="Keycloak\nOpenID Connect / OAuth2\nAuthorization Code + PKCE\nPasskeys or password + TOTP\nJWT issuance; admin MFA"];
    database [shape=cylinder, label="PostgreSQL\nSeparate application and identity databases\nConstraints; views; restricted roles"];
    { rank=same; api; identity; }

    api -> database [label="SQL; transactions\nserialized scheduling writes"];
    identity -> database [label="Identity data\nseparate owner"];
    api -> identity [label="Discovery / JWKS", style=dashed, constraint=false];
  }

  browser -> api [label="HTTPS\nREST + Bearer access JWT\nJSON / XML / Atom / text"];
  browser -> identity [label="HTTPS\nOIDC login + MFA\ncode exchange with PKCE", dir=both];
}
